<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp">

    <!-- TÍTULO DEL JUEGO -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/game_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- ESTADO DEL JUEGO -->
    <TextView
        android:id="@+id/information"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/turn_human"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!--
        TABLERO PERSONALIZADO - RETO 5

        En lugar de utilizar nueve botones,
        ahora utilizamos la clase BoardView.

        BoardView dibuja el tablero directamente
        utilizando Canvas.
    -->
    <co.edu.unal.tictactoe.BoardView
        android:id="@+id/boardView"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

    <!-- BOTÓN PARA INICIAR UNA NUEVA PARTIDA -->
    <Button
        android:id="@+id/restartButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/new_game"
        android:layout_marginTop="24dp" />

</LinearLayout>